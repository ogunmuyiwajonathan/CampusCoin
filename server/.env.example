# Copy to .env and fill in. Only .env.example is committed; .env is gitignored.

NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed to call this API.
# In dev the Vite proxy makes the app same-origin, so this matters in production.
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas. Required - the server refuses to boot without it.
# Put the database name after the host and before the ?:
#   mongodb+srv://<user>:<password>@cluster0.<id>.mongodb.net/campuscoin?retryWrites=true&w=majority
# Percent-encode any special characters in the password (@ # % / : are the usual
# culprits). The database name is not optional: without one the driver falls back
# to the authentication database, which is not where the app data lives.
MONGODB_URI=

# Signs the session cookie. Required in production; a fixed development default
# is used otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Overrides the origin used in password-reset links. Without it the
# request host is used, which works on localhost and on a preview URL.
# APP_ORIGIN=https://campuscoin.onrender.com

# Optional. With no key the mailer prints the reset link to the server console
# instead of emailing it, so the reset flow stays testable before email is set
# up. On the Resend free tier the only permitted sender is
# onboarding@resend.dev, and it can only deliver to the account owner's address.
RESEND_API_KEY=
EMAIL_FROM=CampusCoin <no-reply@resend.dev>

# Optional. Rix, the AI assistant. Poolside speaks the OpenAI protocol, so the
# key goes straight to the OpenAI SDK with the base URL pointed at Poolside.
# With no key the assistant still works: it answers from the student's own
# figures using the tips rules and labels every reply "offline mode", so nothing
# on screen ever pretends to be the model when it is not.
#
# This key is never rotated, regenerated or changed by any script. If it returns
# an auth error, the app reports it and falls back to offline mode - the fix is a
# human checking the Poolside dashboard, not editing a file.
POOLSIDE_API_KEY=
POOLSIDE_BASE_URL=https://inference.poolside.ai/v1
POOLSIDE_MODEL=poolside/laguna-xs-2.1

# Questions per hour one account may ask Rix. Defaults to 60 when blank.
# The test suite runs at 1000 automatically under NODE_ENV=test; that raised
# ceiling is refused outright when NODE_ENV=production.
AI_RATE_LIMIT=60

# Admin access. There are no admin accounts in the database: POST
# /api/admin/auth/login compares the submitted password directly against
# ADMIN_SEED_PASSWORD, so changing this value and restarting changes the admin
# password. Leave it blank and no admin can sign in. ADMIN_EMAIL only sets the
# display name shown in the admin panel and is never used as a login key.
ADMIN_EMAIL=admin@campuscoin.test

# The admin panel password. Anyone who knows this value is the admin, so keep
# it out of git and out of screenshots.
ADMIN_SEED_PASSWORD=
