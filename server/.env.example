# Copy to .env and fill in. Only .env.example is committed; .env is gitignored.

NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed to call this API.
# In dev the Vite proxy makes the app same-origin, so this matters in production.
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas. Required - the server refuses to boot without it.
# Put the database name after the host and before the ?:
#   mongodb+srv://<user>:<password>@cluster0.<id>.mongodb.net/campuscoin?retryWrites=true&w=majority
# Percent-encode any special characters in the password (@ # % / : are the usual
# culprits). The database name is not optional: without one the driver falls back
# to the authentication database, which is not where the app data lives.
MONGODB_URI=

# Signs the session cookie. Required in production; a fixed development default
# is used otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Overrides the origin used in password-reset links. Without it the
# request host is used, which works on localhost and on a preview URL.
# APP_ORIGIN=https://campuscoin.onrender.com

# Optional. With no key the mailer prints the reset link to the server console
# instead of emailing it, so the reset flow stays testable before email is set
# up. On the Resend free tier the only permitted sender is
# onboarding@resend.dev, and it can only deliver to the account owner's address.
RESEND_API_KEY=
EMAIL_FROM=CampusCoin <no-reply@resend.dev>
