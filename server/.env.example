# Copy to .env and fill in. Only .env.example is committed; .env is gitignored.

NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed to call this API.
# In dev the Vite proxy makes the app same-origin, so this matters in production.
CORS_ORIGIN=http://localhost:5173

# MongoDB. Leave MONGODB_URI blank to run against an in-memory MongoDB, which is
# what development and the test suite use: it starts empty, needs no network, and
# throws its data away on exit. Set a real URI to use a real server, and put the
# database name (campuscoin) after the host and before the ?.
# Percent-encode any special characters in the password.
#
# Blank is only ever allowed outside production. A production boot with no
# MONGODB_URI refuses to start rather than silently running on a database that
# discards every write.
MONGODB_URI=

# Optional. Points the in-memory database at a mongod you already have, instead
# of downloading one (781 MB) on first run. Useful when the download is blocked
# or slow on your network. On Windows, extracting the MongoDB server installer
# with `msiexec /a <file.msi> /qn TARGETDIR=<dir>` produces bin\mongod.exe.
# MONGOMS_SYSTEM_BINARY=D:\mongodb-portable\MongoDB\Server\8.2\bin\mongod.exe
