# Base URL of the Express API (server folder)
# Vite reads VITE_* at BUILD time and inlines it into the bundle, so this must be
# set before the frontend builds. Changing it in a dashboard afterwards has no
# effect until the next deploy.
#
# Must end in /api: the server mounts every route under /api, so a bare origin
# gives 404 on every call.
VITE_API_URL=http://localhost:5000/api

# When the frontend is deployed separately from the API (Vercel + Render), set
# the API's real origin in the host's environment variables and add this
# frontend's own origin to the server's CORS_ORIGIN, or the browser blocks every
# request.

# Development-only demo student login. Leave both blank in production; the
# login form only pre-fills them when import.meta.env.DEV is true.
VITE_DEMO_STUDENT_EMAIL=
VITE_DEMO_STUDENT_PASSWORD=
